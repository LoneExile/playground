        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "NOT ONLINE",
                  "color": "red",
                  "index": 1
                }
              }
            }
